# OmniRole AI Environment Configuration

# Backend Settings
PROJECT_NAME="OmniRole AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000
SECRET_KEY="omnirole_super_secret_key_change_me"

# Database Configuration (SQLite default for local, Supabase / Postgres for production)
DATABASE_URL="sqlite:///./omnirole.db"
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# AI LLM Provider Configuration ("mock" or "openai_compatible")
LLM_PROVIDER="mock"

# Remote Inference Server (Qwen / vLLM / Ollama / OpenAI Compatible)
LLM_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY=""
LLM_MODEL="qwen-2.5-72b-instruct"
LLM_TIMEOUT_SECONDS=60.0

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"
